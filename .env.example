# --- Required: a FusionSolar account with access to the plant (owner account works) ---
FUSIONSOLAR_USER=
FUSIONSOLAR_PASSWORD=

# --- Required: password for the web app. The server refuses to start without it; use 8+ characters. ---
# Changing it logs out every open session.
APP_PASSWORD=
# Set to 1 only when running behind a reverse proxy (it then trusts X-Forwarded-For/-Proto/-Host).
TRUST_PROXY=

# --- Optional. Empty values are taken from FusionSolar or disabled. ---

# Friendlier name for the dashboard title (default: the plant name in FusionSolar).
PLANT_NAME=
# Plant time zone (default: the one FusionSolar reports for the plant).
PLANT_TZ=
# Days of history to fetch on start (FusionSolar keeps about two years of 5-minute data).
BACKFILL_DAYS=730

# Battery. Capacity and minimum SOC default to what FusionSolar reports.
BATTERY_KWH=
BATTERY_MIN_PCT=
# Reserve kept for power cuts ("Backup power SOC" in the FusionSolar app). The API does not expose it,
# so it is only shown when set here. BATTERY_RESERVE_SINCE (YYYY-MM-DD) defaults to the day it is first set.
BATTERY_RESERVE_PCT=
BATTERY_RESERVE_SINCE=

# Money (Spanish 2.0TD tariff, Península). Leave PRICE_P1..P3 empty to hide euro figures.
# Energy price per period in EUR/kWh, as printed on the bill (tolls and charges included).
PRICE_P1=
PRICE_P2=
PRICE_P3=
# Surplus compensation, EUR/kWh.
PRICE_EXPORT=
# Extra EUR per imported kWh not included above (e.g. REE adjustment services).
PRICE_ADJUST=
# Fixed terms: power price in EUR per kW and year, contracted power in kW, daily social bonus and meter rent.
PRICE_POWER_P1=
PRICE_POWER_P2=
POWER_P1_KW=
POWER_P2_KW=
PRICE_SOCIAL_BONUS_DAY=
PRICE_METER_DAY=
# Taxes in percent: electricity tax (5.11269) and VAT (21).
TAX_ELECTRICITY_PCT=
TAX_VAT_PCT=

# Assistant and bills (optional). AI_API_KEY is an OpenRouter key. Without it the assistant is hidden and bills are
# entered by hand. With it, each uploaded bill file (it carries your name and address) and each question to the
# assistant is sent to OpenRouter, asking for providers that do not keep or train on it. Bill files stay in
# data/bills and can be deleted from Settings. About 0.005 USD per bill and about 0.007 USD per question.
AI_API_KEY=
# Model for reading bills (default google/gemini-3.1-flash-lite) and for the assistant (default google/gemini-3.8-flash).
AI_MODEL_EXTRACT=
AI_MODEL_CHAT=
# Used when the assistant's model fails on the first round (default qwen/qwen3.8-27b; none disables it).
AI_MODEL_CHAT_FALLBACK=
# How much the assistant's model thinks: off, low (default), medium or high. medium costs about twice as much.
AI_CHAT_REASONING=
# Monthly spending limit in US dollars (default 5; ten questions a day come to about 2 USD). Over it, uploads are
# stored but not read and the assistant pauses.
AI_MONTHLY_BUDGET_USD=
# Web search for the assistant (optional): a Jina key (https://jina.ai); the account needs balance. Without it the
# assistant says web search is unavailable. Jina receives the search queries (refused when they hold your data) and
# the addresses of public pages to read. Market prices come from Red Eléctrica, which receives only dates.
JINA_API_KEY=

# Alert emails (optional). Without SMTP_HOST alerts are only listed in the app. Never shown in the UI.
# SMTP server name and port (587 for STARTTLS, 465 for TLS). SMTP_SECURE=1 forces TLS from the start, 0 turns it
# off; left empty it is on for port 465 and off otherwise.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# SMTP login (leave empty if the server needs none). SMTP_PASSWORD works too, if you prefer that name.
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Solar <solar@example.com>" (default: SMTP_USER).
SMTP_FROM=
# First recipients, comma separated, used until the alert settings are saved once in the app (Settings, Alerts),
# where each address chooses its language and its alerts.
ALERT_TO=
# Public address of this app, used for the link in alert emails (e.g. https://solar.example.com).
APP_URL=

# Docker host binding (docker-compose.yml). Default 127.0.0.1:8080. Behind a reverse proxy on another host use 0.0.0.0.
OFS_BIND=
OFS_PORT=
